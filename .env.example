# ── 웹 (Vite) ── Supabase 프로젝트 > Settings > API. 업무일지(kingtepad)와 같은 프로젝트를 쓴다
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# 웹 푸시 공개키 (업무일지 apps/api/.env 의 VAPID_PUBLIC_KEY 와 같은 값). 비우면 푸시 메뉴가 안 보인다
VITE_VAPID_PUBLIC_KEY=

# ── 포털 API (server/) ── 초대·계정 관리. 서버에서만 쓰는 값
HOST=127.0.0.1
PORT=8090
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# 절대 웹(VITE_)에 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# 초대 메일 링크 · 네이버 로그인이 돌아올 주소 (로컬 개발이면 http://localhost:5173)
PUBLIC_URL=https://ae2p.duckdns.org

# ── 네이버 로그인 (server/naver.ts) ── 네이버 개발자센터 > Application. 비우면 네이버 로그인이 꺼진다
# Callback URL 은 <PUBLIC_URL>/api/portal/naver/callback 으로 등록한다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# true 면 웹 빌드에 네이버 버튼 · 계정 설정의 네이버 항목이 생긴다 (빌드 때 읽으므로 바꾸면 다시 빌드)
VITE_NAVER_ENABLED=

# ── Claude 작업실 (server/builder.ts) ── 테스트 서버에서만 켠다. 운영 서버에는 넣지 말 것
# true 면 pm2 가 ae2p-builder 를 띄우고, 웹 빌드에 작업실 메뉴가 생긴다
BUILDER_ENABLED=
VITE_BUILDER_ENABLED=
BUILDER_PORT=8095
# Console(platform.claude.com) API 키. 비우면 서버의 Claude Code 로그인(claude 실행 후 /login)을 쓴다
ANTHROPIC_API_KEY=
# Claude 가 고칠 폴더 (기본: 이 저장소). 첨부 파일은 BUILDER_UPLOAD_DIR (기본: ../builder-uploads)
BUILDER_WORK_DIR=
BUILDER_UPLOAD_DIR=
# 더 열어 줄 폴더 (쉼표 구분 절대 경로, 예: /home/ubuntu/kingtepad,/home/ubuntu/careerpad)
BUILDER_EXTRA_DIRS=
# 모델 · 생각 깊이(low|medium|high|xhigh|max) · 요청 한 번의 비용 상한(달러) · 최대 턴
BUILDER_MODEL=claude-opus-5-5
BUILDER_EFFORT=high
BUILDER_MAX_BUDGET_USD=5
BUILDER_MAX_TURNS=100
