{
  "expo": {
    "name": "ae:p",
    "slug": "aep",
    "scheme": "aep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devsixt.aep",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.devsixt.aep",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#D5E0DC",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#131C25"
          }
        }
      ],
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Apple Watch · 건강 앱에 기록된 운동(종류 · 시간 · 거리 · 칼로리 · 심박)을 읽어 운동기록에 자동으로 남깁니다.",
          "NSHealthUpdateUsageDescription": "ae:p는 건강 앱에 데이터를 기록하지 않고 읽기만 합니다. 건강 앱 연동 구성요소가 요구하는 안내 문구입니다.",
          "background": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6ccb45f2-46f7-471a-a9b3-0718d1999a74"
      }
    },
    "owner": "devsixt"
  }
}
