# /etc/caddy/Caddyfile — ae2p.duckdns.org 한 도메인에 포털과 모든 앱을 경로로 나눠 올린다.
# 이 파일 전체로 /etc/caddy/Caddyfile 을 바꾼다 (설치 때 들어 있는 ':80 { root * /usr/share/caddy … }' 예시 블록은 지운다)
# 바꾼 뒤: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# 캐시: 앱마다 HTML 은 no-cache(매번 확인)로 보낸다. 헤더가 없으면 브라우저가 몇 시간씩 서버에 묻지 않고 옛 HTML 을 쓴다
#       (2026-10-21: Caddy 에 /workout/ 이 빠져 있던 동안 받은 포털 HTML 을 계속 써서 운동기록이 포털 홈으로 튕겼다)
# Caddy 사용자가 각 dist 폴더를 읽을 수 있어야 한다 (예: chmod o+x /home/ubuntu)

ae2p.duckdns.org {
	encode zstd gzip

	# ── 포털 API (초대·계정 관리, pm2: ae2p-portal-api) ──
	handle_path /api/portal/* {
		reverse_proxy 127.0.0.1:8090
	}

	# ── 업무일지 (kingtepad, pm2: kingtepad-api) ── 웹은 base '/diary/' 로 빌드된다
	redir /diary /diary/
	handle_path /api/diary/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle_path /diary/* {
		root * /home/ubuntu/kingtepad/apps/web/dist
		# 해시가 붙은 빌드 파일 말고는(HTML 등) 매번 서버에 확인 (바뀌지 않았으면 304)
		@diary_html not path /assets/*
		header @diary_html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# ── 운동기록 (work-doubt, pm2: workout-api) ── Expo 웹은 baseUrl '/workout' 으로 빌드된다
	redir /workout /workout/
	handle_path /api/workout/* {
		# AI 코치 답변(SSE)을 버퍼링 없이 바로 흘려보낸다
		reverse_proxy 127.0.0.1:8091 {
			flush_interval -1
		}
	}
	handle_path /workout/* {
		root * /home/ubuntu/work-doubt/app/dist
		# 해시가 붙은 빌드 파일 말고는(HTML 등) 매번 서버에 확인 (바뀌지 않았으면 304)
		@workout_html not path /_expo/* /assets/*
		header @workout_html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# ── 커리어++ (careerpad, pm2: careerpad-api) ── 웹은 base '/career/' 로 빌드된다.
	# 공개 페이지(/career/<slug>)는 로그인 없이 열린다 — 공개 범위는 API 가 정한다
	redir /career /career/
	handle_path /api/career/* {
		reverse_proxy 127.0.0.1:8092
	}
	handle_path /career/* {
		root * /home/ubuntu/careerpad/web/dist
		# 해시가 붙은 빌드 파일 말고는(HTML 등) 매번 서버에 확인 (바뀌지 않았으면 304)
		@career_html not path /assets/*
		header @career_html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# ── 에이전트 ── 앱을 올릴 때 위와 같은 모양으로 추가

	# ── 포털 (나머지 전부) ──
	handle {
		root * /home/ubuntu/ae2p/dist
		# 해시가 붙은 빌드 파일(/assets/) 말고는 매번 서버에 확인한다 (바뀌지 않았으면 304).
		# HTML · 서비스워커 · switcher.js 처럼 이름이 고정인 파일을 브라우저가 오래 들고 있으면 옛 화면이 뜬다
		@nocache not path /assets/*
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# 에이전트 모니터의 픽셀 오피스 (kingtepad-api 의 오피스 프록시)
ae2p.duckdns.org:8443 {
	reverse_proxy 127.0.0.1:8081
}

# 예전 업무일지 주소 → 새 주소로 (/tasks/… → /diary/tasks/…)
kingtepad.duckdns.org {
	redir https://ae2p.duckdns.org/diary{uri} permanent
}
