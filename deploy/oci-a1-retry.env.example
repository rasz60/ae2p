# deploy/oci-a1-retry.sh 설정. ~/a1-retry.env 로 복사해서 채운다. 값 찾는 법은 deploy/TEST_SERVER.md 1단계
# 테넌시(루트 구획) OCID — 콘솔 > 프로필 > 테넌시
COMPARTMENT_ID=ocid1.tenancy.oc1..
# 운영 서버와 같은 서브넷 OCID — 콘솔 > 네트워킹 > 가상 클라우드 네트워크 > (VCN) > 서브넷
SUBNET_ID=ocid1.subnet.oc1.ap-osaka-1.
# Ubuntu 24.04 aarch64 이미지 OCID (TEST_SERVER.md 의 명령으로 조회)
IMAGE_ID=ocid1.image.oc1.ap-osaka-1.
# 가용성 도메인 이름 (예: xxxx:AP-OSAKA-1-AD-1)
AD=
# 새 서버에 넣을 SSH 공개키 파일 (이 서버에 올려 둔 경로)
SSH_KEY_FILE=/home/ubuntu/ae2p-test.pub

NAME=ae2p-test
OCPUS=1
MEMORY_GB=6
BOOT_GB=50
# 시도 간격(초). 너무 짧으면 TooManyRequests 가 난다
INTERVAL=180
# oci 명령 경로 (venv 에 설치했다면)
OCI=/home/ubuntu/oci-cli/bin/oci
