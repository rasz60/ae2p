{
  "name": "ae2p",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -p . && tsc -p tsconfig.server.json && vite build && vite build -c vite.switcher.config.ts && tsup",
    "typecheck": "tsc -p . && tsc -p tsconfig.server.json",
    "preview": "vite preview --host",
    "brand": "node design/gen-brand.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
